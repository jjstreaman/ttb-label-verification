# Direct Anthropic API (primary path -- see README "Why direct API, not Vertex").
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_API=claude-sonnet-5

# Passcode gate -- see README "Access control". Leave unset for normal
# ungated local dev. Always set this in the Cloud Run deployment.
# APP_PASSCODE=choose-something-here

# Vertex AI is supported in code but NOT used by default: Claude on Vertex
# requires Anthropic business-account approval (a business name + website),
# which doesn't fit an individual prototype. Uncomment if that changes.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_REGION=global
# CLAUDE_MODEL_VERTEX=claude-sonnet-5
